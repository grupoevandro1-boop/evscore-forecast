function shiftDate(days) {
  const d = new Date();
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0, 10);
}

function normalizeFixture(raw) {
  const fixture = raw?.fixture ?? {};
  const teams = raw?.teams ?? {};
  const goals = raw?.goals ?? {};
  const league = raw?.league ?? {};

  const homeTeam = teams.home?.name ?? 'Time da casa';
  const awayTeam = teams.away?.name ?? 'Time visitante';
  const homeGoals = typeof goals.home === 'number' ? goals.home : undefined;
  const awayGoals = typeof goals.away === 'number' ? goals.away : undefined;

  const form = `${Math.random() > 0.5 ? 'W' : 'D'}${Math.random() > 0.5 ? 'W' : 'L'}${Math.random() > 0.5 ? 'W' : 'D'}${Math.random() > 0.5 ? 'L' : 'W'}${Math.random() > 0.5 ? 'W' : 'D'}`;

  return {
    id: fixture.id ?? Math.round(Math.random() * 100000),
    league: league.name ?? 'Liga principal',
    leagueId: league.id ?? 0,
    homeTeam,
    awayTeam,
    kickoff: fixture.date ?? new Date().toISOString(),
    status: fixture.status?.short ?? 'PRÓXIMO',
    homeGoals,
    awayGoals,
    odds: {
      home: raw?.odds?.home ?? 1.9,
      draw: raw?.odds?.draw ?? 3.2,
      away: raw?.odds?.away ?? 3.8,
    },
    goalMarginLast10: Math.floor(Math.random() * 9) - 2,
    form,
    confidence: 70 + Math.floor(Math.random() * 22),
    pick: ['Casa com mais de 1.5 gols', 'Fora ou empate', 'Inter vence', 'Over 2.5', 'Empate com gols'][Math.floor(Math.random() * 5)],
  };
}

async function fetchFixturesFromApi() {
  const key = process.env.API_FOOTBALL_KEY;
  const host = process.env.API_FOOTBALL_HOST || 'v3.football.api-sports.io';

  if (!key) {
    return fallbackFixtures;
  }

  const from = shiftDate(-1);
  const to = shiftDate(3);

  const requests = leagues.map(async (league) => {
    const response = await fetch(
      `https://${host}/fixtures?league=${league.id}&season=2025&from=${from}&to=${to}`,
      {
        headers: {
          'x-rapidapi-key': key,
          'x-rapidapi-host': host,
        },
      },
    );

    if (!response.ok) {
      return [];
    }

    const data = await response.json();
    return (data.response || []).map(normalizeFixture);
  });

  const results = await Promise.all(requests);
  const flattened = results.flat();

  return flattened.length ? flattened.slice(0, 24) : fallbackFixtures;
}

app.get('/api/health', (_req, res) => {
  res.json({ ok: true, status: 'EVSCORE ready' });
});

app.get('/api/fixtures', async (_req, res) => {
  try {
    const fixtures = await fetchFixturesFromApi();
    res.json({ generatedAt: new Date().toISOString(), fixtures });
  } catch (error) {
    res.status(500).json({
      error: 'Falha ao carregar jogos.',
      fixtures: fallbackFixtures,
    });
  }
});

app.listen(PORT, () => {
  console.log(`EVSCORE API running on http://localhost:${PORT}`);
});

module.exports = app;
